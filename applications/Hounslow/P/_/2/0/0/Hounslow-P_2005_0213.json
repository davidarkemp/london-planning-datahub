  "description": "Change of use of ground floor from retail to residential use including single storey rear extension and alterations to front elevation of existing building.",
  "site_name": "1A Market Terrace",
  "last_updated_by": "Northgate M3",
  "decision_target_date": "23/03/2005",
  "borough": "Hounslow",
