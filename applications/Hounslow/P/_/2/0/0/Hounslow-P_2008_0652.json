  "description": "Change of use from car show room to public house incorporating single storey rear extensions.",
  "site_name": "328-330",
  "last_updated_by": "Northgate M3",
  "decision_target_date": "07/05/2008",
  "borough": "Hounslow",
  "postcode": null,
