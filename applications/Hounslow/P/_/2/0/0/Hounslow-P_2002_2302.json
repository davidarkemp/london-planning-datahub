  "bo_system": "Northgate M3",
  "development_type": "Major all other major developments",
  "lapsed_date": "23/10/2007",
  "decision_conditions": [
    "Condition : 1 - The development hereby permitted shall be begun before the expiration of five years from the date of this permission.",
    "Condition : 2 - The materials to be used in the construction of the external surfaces of the extension hereby permitted shall match those used in the existing building.",
    "Condition : 3 - The proposed development shall be carried out in all respects in accordance with the proposals contained in the application and the plans submitted therewith and approved by the Local Planning Authority, or as shall have been otherwise agreed in writing by the Local Planning Authority before the flats are occupied.",
    "Condition : 4 - The conversion to flats hereby permitted shall not be begun until full particulars and details of a scheme to insulate the premises against the transmission of airborne and impact sound has been submitted to and approved by the Local Planning Authority and the development shall not be carried out otherwise than in accordance with any approval given.",
    "Condition : 5 - No additional flank windows or other glazed openings shall be formed in the west wall of the extension hereby approved without the prior written consent of the Local Planning Authority.",
    "Condition : 6 - The use as two flats shall not commence until details of the layout of the two private garden areas has been submitted to and approved by the Local Planning Authority in writing, and the gardens shall be provided in accordance with the approved plans"
  ],
