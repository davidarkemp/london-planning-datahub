  "description": "Erection of single storey rear extension and conversion of existing dwellinghouse into 2 x two bed flats",
  "site_name": "22",
  "last_updated_by": "Northgate M3",
  "decision_target_date": "26/09/2002",
  "borough": "Hounslow",
  "postcode": null,
