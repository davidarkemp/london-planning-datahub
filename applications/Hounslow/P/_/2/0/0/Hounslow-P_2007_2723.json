  "description": "Erection of a two storey extension to side and part front of existing warehouse/industrial building.",
  "site_name": "Westgate Estate",
  "last_updated_by": "Northgate M3",
  "decision_target_date": "17/10/2007",
  "borough": "Hounslow",
