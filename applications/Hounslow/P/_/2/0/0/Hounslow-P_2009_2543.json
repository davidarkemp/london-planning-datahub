  "decision_target_date": "10/12/2009",
  "borough": "Hounslow",
  "postcode": "W4 1QP",
  "street_name": "Turnham Green Terrace",
  "bo_system": "Northgate M3",
  "development_type": "Minor dwellings",
  "lapsed_date": "25/11/2012",
  "decision_conditions": [
    "Condition : 1 - The development hereby permitted shall be begun before the expiration of three years from the date of this permission.",
    "Condition : 2 - The materials to be used in the construction of the external surfaces of the extension hereby permitted shall match those used in the existing building.",
    "Condition : 3 - The proposed development shall be carried out in all respects in accordance with the proposals contained in the application and the plans submitted therewith and approved by the Local Planning Authority, or as shall have been otherwise agreed in writing by the Local Planning Authority before the building is used.",
    "Condition : 4 - No additional flank windows or other glazed openings shall be formed in any elevation of the extension hereby approved without the prior written consent of the Local Planning Authority.",
    "Condition : 5 - Suitable arrangements will be made for the provision of refuse storage and recycling storage on site before the units are occupied.",
    "Condition : 6 - Before the development is commenced a scheme for soundproofing between the first and second floor, and a soundproofing scheme to mitigate external noise will be submitted and approved by the council before the development is first begun."
  ],
