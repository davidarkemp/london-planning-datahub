  "decision_date": "05/02/2001",
  "description": "Erection of single storey rear extension and change of use of ground floor of premises from retail (A1) to one 2-bedroom self-contained flats (C3).",
  "site_name": "80",
  "last_updated_by": "Northgate M3",
