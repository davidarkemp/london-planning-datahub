  "decision_date": "23/01/2003",
  "description": "Demolition of workshop buildings and erection of 12 three storey terraced dwellinghouses and associated parking.",
  "site_name": "DP ROBERTS COACHWORKS, 181",
  "last_updated_by": "Northgate M3",
