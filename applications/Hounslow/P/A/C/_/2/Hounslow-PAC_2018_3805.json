  "decision_date": "21/11/2018",
  "description": "Change of use from offices (Class B1(a)) to residential use (Class C3) to include up to 39 dwellings.",
  "site_name": "Second Floor",
  "last_updated_by": "Northgate M3",
  "decision_target_date": "04/12/2018",
  "borough": "Hounslow",
  "postcode": "TW7 6NA",
