  "decision_conditions": [
    "<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">Commencement of development (LB Consent)</span></u><span style=\"font-size: 14px;\"> - The works hereby permitted\r\nshall be commenced before the expiration of 3 years from the date of this\r\nconsent.</span></span></p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason</span></u><span style=\"font-size: 14px;\">: To comply with the requirements of Section 18 of the Planning\r\n(Listed Buildings and Conservation Areas) Act 1990 as amended by Section 51 of\r\nthe Planning and Compulsory Purchase Act 2004.</span></span></span></p>",
    "<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">Approved Plans</span></u><span style=\"font-size: 14px;\"> - The works hereby permitted shall be carried out\r\nin accordance with the following approved plans:&nbsp;</span></span></p><p style=\"text-align: justify; \">TfL-SW19-17-A-PL-110-01</p><p style=\"text-align: justify; \">TfL-SW19-17-A-PL-110-02</p><p style=\"text-align: justify; \">TfL-SW19-17-A-PL-110-11</p><p style=\"text-align: justify; \"><span style=\"line-height: 107%;\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"></span></p><p style=\"text-align: justify; \">TfL-SW19-17-A-PL-130-11</p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason</span></u><span style=\"font-size: 14px;\">: For the avoidance of doubt and in the interests of proper\r\nplanning</span></span></span></p>",
    "<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">External Materials as Specified</span></u><span style=\"font-size: 14px;\"> - The facing materials to be used for the\r\nworks hereby permitted shall be those specified in the application form\r\nunless otherwise agreed in writing by the Local Planning Authority.</span></span></p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason</span></u><span style=\"font-size: 14px;\">:&nbsp; To ensure a satisfactory\r\nappearance of the development and to comply with the following Development Plan\r\npolicies for Merton: policies D4 and D8 of the London Plan 2021, policies D12.1\r\nand D12.3 of the Local Plan 2024.</span><s></s></span></span></p>"
  ],
