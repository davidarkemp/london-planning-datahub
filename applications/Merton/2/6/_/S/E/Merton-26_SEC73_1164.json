  "decision_conditions": [
    "<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">Approved Plans</span></u><span style=\"font-size: 14px;\"> - The development hereby permitted shall be carried out\r\nin accordance with the following approved plans:&nbsp;</span></span></p><p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 14px;\"><br></span></span></p><p class=\"MsoNormal\">P01_Proposed Site Plan_Rev 6<o:p></o:p></p><p class=\"MsoNormal\">P02 Proposed Ground Floor Plan Rev 6<o:p></o:p></p><p class=\"MsoNormal\">P03 Proposed First Floor Plan Rev 4<o:p></o:p></p><p class=\"MsoNormal\">P04 Proposed Second Floor Plan Rev 4<o:p></o:p></p><p class=\"MsoNormal\">P05 Proposed Roof Floor Plan Rev 4<o:p></o:p></p><p class=\"MsoNormal\">P06 Proposed Front Elevation (SW) Rev 7<o:p></o:p></p><p class=\"MsoNormal\">P07 Proposed Rear Elevation (NE) Rev 7<o:p></o:p></p><p class=\"MsoNormal\">P08 Proposed Side Elevation (SE) Rev 7<o:p></o:p></p><p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n</span></p><p class=\"MsoNormal\">P09 Proposed Side Elevation (NW) Rev 7<o:p></o:p></p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason</span></u><span style=\"font-size: 14px;\">: For the avoidance of doubt and in the interests of proper\r\nplanning</span></span></span></p>",
    "&lt;p style=&quot;text-align: justify; &quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%;\r\nfont-family:&quot; arial&quot;,sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=&quot;&quot; minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=&quot;&quot; ar-sa&quot;=&quot;&quot;&gt;&lt;u&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Commencement of development (Full Permission)&lt;/span&gt;&lt;/u&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; - The development to which\r\nthis permission relates shall be commenced not later than the expiration of 3\r\nyears from the date of permission&amp;nbsp;&lt;/span&gt;&lt;/span&gt;24/P0255.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%;\r\nfont-family:&quot; arial&quot;,sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=&quot;&quot; minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=&quot;&quot; ar-sa&quot;=&quot;&quot;&gt;&lt;span style=&quot;font-size: 12pt; line-height: 107%;&quot;&gt;&lt;u&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Reason:&lt;/span&gt;&lt;/u&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; To comply with Section 91\r\n(as amended) of the Town &amp;amp; Country Planning Act 1990.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-size:11.0pt;line-height:107%;\r\nfont-family:&amp;quot;Aptos&amp;quot;,sans-serif;mso-ascii-theme-font:minor-latin;mso-fareast-font-family:\r\nAptos;mso-fareast-theme-font:minor-latin;mso-hansi-theme-font:minor-latin;\r\nmso-bidi-font-family:&amp;quot;Times New Roman&amp;quot;;mso-bidi-theme-font:minor-bidi;\r\nmso-ansi-language:EN-GB;mso-fareast-language:EN-US;mso-bidi-language:AR-SA&quot;&gt;With\r\nthe exception of condition 2 (approved plans) and condition 4 (obscure glazing)\r\nattached to this permission , all other conditions attached to planning\r\npermission 24/P0255 remain applicable.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;",
    "&lt;p&gt;Before the development hereby permitted is first occupied, all first floor and second floor windows in the north west and south east side elevations shall be glazed with obscured glass and shall be maintained as such thereafter, with the exception of the side facing windows of the front a&lt;/p&gt;&lt;p&gt;Reason: To safeguard the amenities and privacy of the occupiers of adjoining properties.&amp;nbsp;&lt;/p&gt;"
  ],
