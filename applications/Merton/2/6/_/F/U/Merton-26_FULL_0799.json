  "decision_conditions": [
    "<p class=\"MsoNormal\" style=\"\"><span>﻿</span><span style=\"line-height: 107%;\">Travel Plan - Prior to the occupation of the development\r\nhereby permitted,&nbsp;</span>any on-site works,\r\nincluding temporary construction/installation works proposed which may\r\npotentially impair access to public amenities, should ensure clear legible\r\nwayfinding signage and routing is employed, especially for those who may be\r\nneurodivergent or have sensory processing differences.</p><p><span style=\"line-height: 107%;\"></span></p><p class=\"MsoNormal\" style=\"\"><span style=\"line-height: 107%;\">Reason: To provide a safe environment for all users and comply&nbsp;</span>&nbsp;Policy D5 and TfL's Equity in Motion Plan</p>",
    "<p class=\"MsoNormal\" style=\"text-align: justify; \"><span style=\"line-height: 107%;\"><u><span style=\"font-size: 14px;\">Contaminated Land </span></u><span style=\"font-size: 14px;\">&nbsp;-&nbsp;</span></span><span style=\"font-size: 14px;\">Prior to first occupation of the development hereby\r\napproved, the recommendations contained within the submitted risk assessment be implemented as directed.</span></p><p><span style=\"line-height: 107%;\"></span></p><p class=\"MsoNormal\" style=\"text-align: justify;\"><span style=\"line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason</span></u><span style=\"font-size: 14px;\">: In order to protect the health of future occupiers and users of the site and adjoining areas in accordance with the following Development\r\nPlan policies for Merton: policy SI 10 of the London Plan 2021 2021 policy\r\nD12.1 of the Local Plan 2024.</span></span><o:p></o:p></p>",
    "<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">Commencement of development (Full Permission)</span></u><span style=\"font-size: 14px;\"> - The development to which\r\nthis permission relates shall be commenced not later than the expiration of 3\r\nyears from the date of this permission.</span></span></p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason:</span></u><span style=\"font-size: 14px;\">  To comply with Section 91\r\n(as amended) of the Town & Country Planning Act 1990.</span></span></span></p>",
    "<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">Approved Plans</span></u><span style=\"font-size: 14px;\"> - The development hereby permitted shall be carried out\r\nin accordance with the following approved plans:&nbsp;</span></span><span style=\"font-family: Arial, sans-serif;\">MID001P,\r\nEXX-PMR14-K-C250-001 Rev A, EXX-PMR14-WV-001, EXX-PMR14-BL001-01, 020P, 021P,\r\n025P, 031P, 033P, 070P &amp; 080P</span></p><p class=\"MsoNormal\" style=\"text-align:justify\"><span style=\"font-family:&quot;Arial&quot;,sans-serif\"><o:p></o:p></span></p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason</span></u><span style=\"font-size: 14px;\">: For the avoidance of doubt and in the interests of proper\r\nplanning</span></span></span></p>"
  ],
