  "decision_conditions": [
    "<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">Commencement of development (Full Permission)</span></u><span style=\"font-size: 14px;\"> - The development to which\r\nthis permission relates shall be commenced not later than the expiration of 3\r\nyears from the date of this permission.</span></span></p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason:</span></u><span style=\"font-size: 14px;\">  To comply with Section 91\r\n(as amended) of the Town & Country Planning Act 1990.</span></span></span></p>",
    "<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">Approved Plans</span></u><span style=\"font-size: 14px;\"> - The development hereby permitted shall be carried out\r\nin accordance with the following approved plans: [</span></span>Dwg No.: 2026-007-13 Rev: A,</p>\r\n\r\n<p class=\"MsoNormal\">Dwg No.: 2026-007-12 Rev: A,<o:p></o:p></p>\r\n\r\n<p class=\"MsoNormal\">Dwg No.: 2026-007-11 Rev: A,<o:p></o:p></p>\r\n\r\n<p class=\"MsoNormal\">Dwg No.: 2026-007-14 Rev: A,<o:p></o:p></p>\r\n\r\n<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 14px;\">Dwg No.: 2026-007-FS2 Rev: -,</span><span style=\"font-size: 14px;\">]</span></span></p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason</span></u><span style=\"font-size: 14px;\">: For the avoidance of doubt and in the interests of proper\r\nplanning</span></span></span></p>",
    "<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">External Materials as Specified</span></u><span style=\"font-size: 14px;\"> - The facing materials to be used for the\r\ndevelopment hereby permitted shall be those specified in the application form\r\nunless otherwise agreed in writing by the Local Planning Authority.</span></span></p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason</span></u><span style=\"font-size: 14px;\">:  To ensure a satisfactory\r\nappearance of the development and to comply with the following Development Plan\r\npolicies for Merton: policies D4 and D8 of the London Plan 2021, policies D12.1\r\nand D12.3 of the Local Plan 2024.</span><s></s></span></span></p>",
    "<p style=\"text-align: justify; \"><span style=\"font-size: 14px;\">﻿</span><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">Obscured Glazing</span></u><span style=\"font-size: 14px;\"> - Before the development hereby permitted is first\r\noccupied, the windows in the side (east) elevation shall be glazed with obscured glass\r\nand shall be maintained as such thereafter.</span></span></p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason</span></u><span style=\"font-size: 14px;\">:&nbsp; To safeguard the\r\namenities and privacy of the occupiers of adjoining properties and to comply\r\nwith the following Development Plan policies for Merton: policies D3 and D4 of\r\nthe London Plan 2021 and policies D12.3 &amp; D12.4</span></span><span style=\"font-size: 14px; line-height: 107%;\" aptos\",sans-serif;=\"\" mso-ascii-theme-font:minor-latin;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-hansi-theme-font:minor-latin;mso-bidi-font-family:\"times=\"\" new=\"\" roman\";=\"\" mso-bidi-theme-font:minor-bidi;mso-ansi-language:en-gb;mso-fareast-language:=\"\" en-us;mso-bidi-language:ar-sa\"=\"\">&nbsp;</span><span style=\"font-size: 14px; line-height: 107%;\">of the Local Plan\r\n2024.&nbsp;</span></span></p>"
  ],
