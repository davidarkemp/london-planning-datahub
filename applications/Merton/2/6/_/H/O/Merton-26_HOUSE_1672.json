  "cil_liability": null,
  "decision_conditions": [
    "&lt;p class=&quot;MsoNormal&quot; style=&quot;line-height:115%&quot;&gt;The proposed air source heat pump,\r\nby reason of its siting within a prominent position on the principal elevation\r\nand frontage of the property, would appear as an intrusive and visually\r\nprominent feature that would contribute to visual clutter within the\r\nstreetscene and detract from the character and appearance of the host property\r\nand surrounding area and fail to achieve a high standard of design. The\r\nproposal is therefore contrary to NPPF 2026 Policy DP3, London Plan 2021 Policies\r\nD3 and D4, and Merton Local Plan 2024 Policy D12.1 and Policy D12.3.&lt;o:p&gt;&lt;/o:p&gt;&lt;/p&gt;",
    "&lt;p class=&quot;MsoNormal&quot; style=&quot;line-height:115%&quot;&gt;The proposed air source heat pump,\r\nby reason of its siting and failure to demonstrate that acceptable noise levels\r\ncan be achieved, would result in an unacceptable impact on the amenities of\r\nneighbouring occupiers. The submitted noise assessment concludes that the\r\nproposal fails and no mitigation measures have been provided to demonstrate\r\nthat the identified harm can be overcome. The proposal is therefore contrary to\r\nNPPF 2026 Policy P3, London Plan 2021 Policy D14 and Merton Local Plan 2024 Policies\r\nD12.3 and P15.10.&lt;o:p&gt;&lt;/o:p&gt;&lt;/p&gt;"
  ]
}