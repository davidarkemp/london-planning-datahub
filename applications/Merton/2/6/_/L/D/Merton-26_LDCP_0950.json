  "application_type_full": "Lawful development: Proposed use",
  "decision_conditions": [
    "<p style=\"text-align: justify; \"><span style=\"line-height: 107%;\"><u><span style=\"font-size: 14px;\">Enlargement of a dwelling house (Class B) </span></u><span style=\"font-size: 14px;\">- The operations would consist of the enlargement of a dwelling house\r\nwithin the meaning of Class B of Part 1 of Schedule 2 to the Town & Country\r\nPlanning (General Permitted Development) \r\n(England) Order 2015 \"the Order\" and would comply with the\r\ndevelopment tolerances set out in said Class B. The operation would therefore\r\nhave been granted planning permission by Article 3 of the Order.</span></span></p>",
    "<p style=\"text-align: justify; \"><span style=\"line-height: 107%;\"><u><span style=\"font-size: 14px;\">Alteration to the roof of the dwelling house (Class C)</span></u><span style=\"font-size: 14px;\"> - The operations would consist of any other alteration to the roof of the\r\ndwelling house within the meaning of Class C of Part 1 of Schedule 2 to the\r\nTown & Country Planning (General Permitted Development)  (England) Order 2015 \"the Order\"\r\nand would comply with the development tolerances set out in said Class C. The\r\noperation would therefore have been granted planning permission by Article 3 of\r\nthe Order.</span></span></p>",
    "<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">Matching Materials</span></u><span style=\"font-size: 14px;\"> - The facing materials used in the development hereby\r\npermitted shall match those of the existing building in materials, style,\r\ncolour, texture and, in the case of brickwork, bonding, coursing and pointing.</span></span></p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason</span></u><span style=\"font-size: 14px;\">:  To ensure a satisfactory\r\nappearance of the development and to comply with policies D12.1 and D12.3 of\r\nthe Local Plan 2024.</span></span></span></p>",
    "<p style=\"text-align: justify; \"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><u><span style=\"font-size: 14px;\">Approved Plans</span></u><span style=\"font-size: 14px;\"> - The development hereby permitted shall be carried out\r\nin accordance with the following approved plans:&nbsp;</span></span>elmw-150-0, elmw-150-1, elmw-150-3, elmw-150-4 &amp; elmw-150-5&nbsp;</p><p style=\"text-align: justify;\"><span style=\"font-size:12.0pt;line-height:107%;\r\nfont-family:\" arial\",sans-serif;mso-fareast-font-family:aptos;mso-fareast-theme-font:=\"\" minor-latin;mso-ansi-language:en-gb;mso-fareast-language:en-us;mso-bidi-language:=\"\" ar-sa\"=\"\"><span style=\"font-size: 12pt; line-height: 107%;\"><u><span style=\"font-size: 14px;\">Reason</span></u><span style=\"font-size: 14px;\">: For the avoidance of doubt and in the interests of proper\r\nplanning</span></span></span></p>"
  ],
