  "decision_conditions": [
    "&lt;span id=&quot;docs-internal-guid-d53cd3f8-7fff-7f7f-a9c2-74e0a6b390a2&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.38;text-align: justify;margin-top:12pt;margin-bottom:12pt;padding:0pt 5pt 0pt 5pt;&quot;&gt;&lt;span style=&quot;font-size: 14px; font-family: Arial, sans-serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;&quot;&gt;The proposed change of use from Class C2 (&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Arial, sans-serif; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;&quot;&gt;assisted living residential accommodation&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Arial, sans-serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;&quot;&gt;) to Class E (Office) would result in the unjustified loss of two specialist C2 residential units, with no robust evidence that the accommodation is no longer required or viable. The development would therefore conflict with Policies LP18 (Part E) and LP24 of the Hackney Local Plan 2033, London Plan Policy H4, and the&lt;/span&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: Arial, Helvetica, sans-serif; font-size: 14px;&quot;&gt;&amp;nbsp;National Planning Policy Framework.&lt;/span&gt;&lt;/p&gt;&lt;/span&gt;"
