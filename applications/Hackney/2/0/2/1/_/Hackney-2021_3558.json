  "decision_conditions": [
    "&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;background-color:#ffffff;margin-top:0pt;margin-bottom:0pt;padding:0pt 0pt 8pt 0pt;&quot;&gt;&lt;span style=&quot;font-size:11pt;font-family:Arial,sans-serif;color:#222222;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;The Development hereby permitted shall only be carried out and completed strictly in accordance with the submitted plans hereby approved and any subsequent approval of details.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span id=&quot;docs-internal-guid-8c3ddcaa-7fff-8ce9-278f-faccfb0574ac&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;background-color:#ffffff;margin-top:0pt;margin-bottom:8pt;&quot;&gt;&lt;span style=&quot;font-size:11pt;font-family:Arial,sans-serif;color:#222222;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;REASON: To ensure that the development hereby permitted is carried out in full accordance with the plans hereby approved.&lt;/span&gt;&lt;/p&gt;",
    "&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;background-color:#ffffff;margin-top:0pt;margin-bottom:0pt;padding:0pt 0pt 8pt 0pt;&quot;&gt;&lt;span style=&quot;font-size:11pt;font-family:Arial,sans-serif;color:#222222;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;The development hereby permitted must be begun not later than the expiration of three years beginning with the date of this permission.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span id=&quot;docs-internal-guid-ae70bc10-7fff-e555-cb3c-8e45cc8893de&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;background-color:#ffffff;margin-top:0pt;margin-bottom:8pt;&quot;&gt;&lt;span style=&quot;font-size:11pt;font-family:Arial,sans-serif;color:#222222;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;&quot;&gt;REASON: In order to comply with the provisions of the Town and Country Planning Act 1990 (as amended).&lt;/span&gt;&lt;/p&gt;&lt;p&gt;\r\n&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif; font-size: 16px; white-space-collapse: preserve;&quot;&gt;A landscaping scheme for rear garden illustrated on detailed drawings &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Arial, sans-serif; font-size: 12pt; white-space-collapse: preserve;&quot;&gt;shall be submitted to and approved in writing by the Local Planning Authority within 6 weeks of the date of this decision. F&lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif; font-size: 16px; white-space-collapse: preserve;&quot;&gt;or either the planting of trees and shrubs/plants showing species, type of stock, numbers of trees and shrubs to be included and showing areas to be grass seeded or turfed; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Arial, sans-serif; font-size: 12pt; white-space-collapse: preserve;&quot;&gt;and shall be carried out and implemented on site within a period of four months from the date of this approval and or &lt;/span&gt;&lt;span id=&quot;docs-internal-guid-b1ebd46e-7fff-8d0c-4177-aebb898ec1c3&quot;&gt;&lt;span style=&quot;font-size: 12pt; font-family: Arial, sans-serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;&quot;&gt;shall be carried out in the first planting (and seeding) season following completion of the relevant part of the development, and shall be maintained to the satisfaction of the Local Planning Authority; &lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Arial, sans-serif; font-size: 12pt; white-space-collapse: preserve;&quot;&gt;such maintenance is to include the replacement of any plants that die, or are severely damaged, seriously diseased, or removed.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; font-family: Arial, sans-serif; font-size: 12pt; white-space-collapse: preserve;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; font-size: 12pt; font-family: Arial, sans-serif; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;&quot;&gt;REASON: To provide biodiversity leading to net gain. And t&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Arial, sans-serif; font-size: 12pt; white-space-collapse: preserve; text-align: justify;&quot;&gt;o enhance the character, appearance and ecology of the site&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Arial, sans-serif; font-size: 12pt; white-space-collapse: preserve; text-align: justify; text-indent: -15.3071pt;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;span id=&quot;docs-internal-guid-d500a602-7fff-644c-cd5a-4fd06be255ff&quot;&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12pt; font-family: Arial, sans-serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;"
