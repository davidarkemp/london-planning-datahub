  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;The proposed LED digital billboard, by reason of its location, illumination, image changes and potential movement is considered to result in harm to highway and pedestrian safety. The proposal is therefore contrary to the Policies T2 and T4 of the London Plan (2021), Policies LP41 and LP42 of the Hackney Local Plan 2033, and the NPPF 2024.&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;The proposed LED digital billboard, by reason of its scale, siting, design and digital characteristics, would appear visually intrusive and incongruous within the streetscene and would contribute to signage clutter, resulting in harm to visual amenity. The proposal is therefore contrary to the to&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Policies D3, D4 and D8 of the London Plan (2021),&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;Policies LP7, LP41 and LP42 of the Hackney Local Plan (2033), &amp;nbsp;and the NPPF 2024.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;"
  ],
