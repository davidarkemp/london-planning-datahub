{
  "decision_conditions": [
    "<p>The development hereby permitted must be begun not later than the expiration of three years beginning with the date of this permission.</p><p><br></p><p>\r\n</p><p>\r\nREASON: In order to comply with the provisions of the Town and Country Planning Act 1990 (as amended).</p><p>\r\n</p>",
    "&lt;p&gt;&lt;span style=&quot;white-space: pre; white-space: normal;&quot;&gt;\t&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Prior to occupation, at least 1 bird/bat box shall be provided below eaves level at the development hereby approved and thereafter retained.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;REASON: In the interests of improvements to biodiversity.&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;white-space: pre; white-space: normal;&quot;&gt;\t&lt;/span&gt;&lt;/p&gt;&lt;p&gt;All new external finishes in respect of all the works hereby approved (and any other incidental works to be carried out in this connection) shall match the existing building in respect of materials used, detailed execution and finished appearance, unless otherwise stated on the drawings hereby approved.&lt;/p&gt;&lt;p&gt;All external materials and windows, doors, roof are conditioned with detailed drawings and product specifications to ensure that the desired quality is achieved.&amp;nbsp;&lt;/p&gt;&lt;p&gt;REASON: To ensure that the external appearance of the building is satisfactory and does not detract from the character and visual amenity of the area.&lt;/p&gt;",
    "<p>The Development hereby permitted shall only be carried out and completed strictly in accordance with the submitted plans hereby approved and any subsequent approval of details.\r\n</p><p><br></p><p>\r\nREASON: To ensure that the development hereby permitted is carried out in full accordance with the plans hereby approved.\r\n</p>"
  ],
