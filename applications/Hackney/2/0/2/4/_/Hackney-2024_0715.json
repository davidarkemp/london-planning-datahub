  "description": "Erection of a part-one part-two storey roof extension, accommodating six self-contained flats with associated landscaping, PV panels and cycle and waste storage.",
  "subdivision_of_building": null,
  "actual_completion_date": null,
  "lpa_app_no": "2024/0715",
  "decision": "Approved",
  "application_type_full": "Full planning permission",
