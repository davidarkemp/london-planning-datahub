  "description": "1x Proposed free-standing internally illuminating Advert Panel with 2no. digital displays on either side.&nbsp;",
  "subdivision_of_building": null,
  "actual_completion_date": null,
  "lpa_app_no": "2024/2616",
  "decision": "Refused",
  "application_type_full": "Consent to display an advertisement",
  "last_updated_by": "Portal",
