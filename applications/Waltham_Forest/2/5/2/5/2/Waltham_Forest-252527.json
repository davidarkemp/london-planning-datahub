  "decision_conditions": [
    "The development hereby permitted shall be carried out in accordance with the following approved plans and thereafter maintained as such for the lifetime of the development: - drawing number 300_C_111_02 Rev 05 dated 23rd October 2025.",
    "&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;The development shall fully conform with the recommendations of Arboricultural Impact Assessment 230971-PD-11b and&amp;nbsp;Arboricultural Addendum&amp;nbsp;&lt;/span&gt;230971-PD-19b dated October 2025. The development shall be carried out solely in accordance with the approved details, all works shall comply with BS 3998:2010 (Tree Work - Recommendations) and shall be supervised by a suitably qualified Arboriculturalist and any post-construction mitigation measures shall thereafter be maintained for the lifetime of the development.&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;The Class F1 use hereby approved shall only operate between the hours of 07:00 - 22:00 (Monday to Sunday).&lt;/span&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;The Class E(b) use hereby approved shall only operate between the hours of 07:00 - 22:00 (Monday to Sunday).&lt;/span&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;The Class E(c) and E(g) use hereby approved shall only operate between the hours of 07:00 - 22:00 (Monday to Sunday).&lt;/span&gt;&lt;/p&gt;"
  ],
