  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;line-height:normal&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;The&amp;nbsp;proposed alteration to the roof profile would create an incongruous, bulky, unsympathetic roof design to the dwellinghouse which due to its overall size, would not appear in keeping with its surroundings, and therefore would create harmful development to the character of the dwellinghouse and wider area, which would not be supported by policy 53 of Waltham Forests LP1 (2024), or policy D1 or D4 of the London Plan (2021). &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;line-height:normal&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span arial=&quot;&quot;&gt;The proposed roof dormers by reason of their design, overall bulk and width would be out of keeping with host property which would be &lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span arial=&quot;&quot;&gt;visually dominant and top-heavy additions to the roof, contrary to &lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span arial=&quot;&quot;&gt;policy 53 of Waltham Forests LP1 (2024), or policy D1 or D4 of the London Plan (2021).&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br data-cke-eol=&quot;1&quot;&gt;&lt;/p&gt;"
  ],
