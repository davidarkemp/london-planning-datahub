  "decision_conditions": [
    "The development hereby permitted shall begin not later than the expiration of three years from the date of this permission.",
    "&lt;p&gt;&lt;span style=&quot;background-color: rgb(229, 229, 229);&quot;&gt;Notwithstanding the provisions of the Town and Country Planning (Use Classes) Order 1987 or the Town and Country Planning (General Permitted Development) (England) Order 2015 (or any orders revoking and re-enacting those orders with or without modification), the hereby approved premises shall only be used as a residential care home (use class C2) for no more than 3 residents (and associated carers) and for no other purposes whatsoever, without prior written agreement of the Local Planning Authority.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;",
