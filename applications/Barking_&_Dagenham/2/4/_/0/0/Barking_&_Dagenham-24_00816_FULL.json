{
  "borough": "London Borough of Barking and Dagenham",
  "application_type": "All Other",
  "decision": "Refused",
  "decision_conditions": [
    "&lt;div&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif; font-size: 11pt;&quot;&gt;The retrospective extension are,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif; font-size: 14.6667px;&quot;&gt;by reason of their poor design, including the discordant roofscape on the front elevation of the west side elevation,&amp;nbsp;and construction with substandard materials which are not sympathetic to the painted white brickwork which the original building is constructed with, are&lt;/span&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif; font-size: 11pt;&quot;&gt;&amp;nbsp;considered to present&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif; font-size: 14.6667px;&quot;&gt;incongruous additions to the Locally Listed Building that fail to reflect its heritage.&amp;nbsp;&lt;/span&gt;As such, the proposed development is contrary to:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;p&gt;&lt;span style=&quot;font-size: 10.5pt; font-family: &quot; pt=&quot;&quot; sans&quot;,=&quot;&quot; sans-serif;&quot;=&quot;&quot;&gt;-&lt;/span&gt;&lt;span pt=&quot;&quot; sans&quot;,=&quot;&quot; sans-serif;&quot;=&quot;&quot; style=&quot;font-size: 10.5pt;&quot;&gt;National Planning Policy Framework&amp;nbsp;&lt;/span&gt;National Planning Policy Framework (NPPF) (DLUHC, 2021)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; -Policies D4 and HC1 of the London Plan (March 2021)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; -&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif; font-size: 11pt;&quot;&gt;Policies DMD1 and DMD4 of&amp;nbsp;&lt;/span&gt;The London Borough of Barking and Dagenham’s Local Plan 2037 (September 2024)&lt;/p&gt;&lt;/div&gt;"
  ],
