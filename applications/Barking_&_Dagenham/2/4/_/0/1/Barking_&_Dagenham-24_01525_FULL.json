{
  "borough": "London Borough of Barking and Dagenham",
  "application_type": "All Other",
  "decision": "Refused",
  "decision_conditions": [
    "&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11pt&quot;&gt;1.&amp;nbsp;The proposed&amp;nbsp;siting and appearance of the proposed shutter would appears at odds with the immediate&amp;nbsp;local character and would introduce an&amp;nbsp;abrupt&amp;nbsp;and incongruous feature&amp;nbsp;onto the street scene,&amp;nbsp;protruding forward of the the current building line of the terrace and shopping parade.&amp;nbsp;As such, the proposed development is considered unacceptable and contrary to:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size:11pt&quot;&gt;- National Planning Policy Framework (NPPF) (DLUHC, 2024);&lt;br&gt;- Policies D4 &amp;amp; D8 of the London Plan (March 2021);&lt;br&gt;- Policies SP2, DMD1 &amp;amp; DMD3 of the LBBD’s Local Plan (September 2024); and&lt;br&gt;- Walking and Cycling Strategy for Barking and Dagenham (BeFirst, August 2021).&lt;/span&gt;&lt;/p&gt;"
  ],
