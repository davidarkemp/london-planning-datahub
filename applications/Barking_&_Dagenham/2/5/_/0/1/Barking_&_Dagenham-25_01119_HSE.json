  "decision_conditions": [
    "&lt;p&gt;The development hereby approved shall only be carried out in accordance with the following approved plans and documents:&lt;/p&gt;&lt;p&gt;-Pre-Existing &amp;amp; Existing Ground Floor Plans and Location Plan - drawing no. HI25/1-6 - dated July 2025&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-Pre-Existing &amp;amp; Existing First Floor Plans and Roof Plan - drawing no. HI25/2-6 - dated July 2025&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-Pre-Existing &amp;amp; Existing Side &amp;amp; Front Elevations - drawing no. HI25/3-6 - dated July 2025&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-Part Pre-Existing Rear Elevation - drawing no. 03a of 05 - n.d&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-Part Existing Rear Elevation - drawing no. 03b of 05 - n.d&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;-Pre-Existing Site/Block Plan -&amp;nbsp; drawing no. HI25/4-6 - dated July 2025&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; -&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif; font-size: 11pt;&quot;&gt;Existing Site/Block Plan - drawing no. HI25/5-6 - dated July 2025&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; -&lt;/span&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif; font-size: 11pt;&quot;&gt;Proposed Block Plan - drawing no. HI25/5-6 - dated July 2025&lt;/span&gt;&lt;/p&gt;&lt;p&gt;No other drawings or documents apply.&lt;/p&gt;",
    "<p class=\"MsoNormal\">The materials to be used in the construction of the external surfaces of the development hereby permitted shall match those used in the existing dwellinghouse.<br></p>",
    "The development hereby permitted shall be commenced before the expiration of three months from the date of this permission.&lt;br&gt;",
    "&lt;p&gt;The two-storey side extension may only be used for purposes incidental to the enjoyment of the dwellinghouse&amp;nbsp;as such. It shall not be used for purposes conflicting with the use of the property as a single dwellinghouse, and in particular it shall not be used as a separate unit of accommodation.&lt;/p&gt;",
    "&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11pt&quot;&gt;The front door to the converted garage shall be removed in accordance with drawing HI25/3-6 within 3 months of the date of this notice.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align:justify&quot;&gt;&lt;br&gt;&lt;/p&gt;"
  ],
