{
  "borough": "Barking And Dagenham",
  "application_type": "All Other",
  "decision": "Refused",
  "decision_conditions": [
    "&lt;p&gt;The proposed development results in the loss of a family-sized dwellinghouse, the need for which is clearly demonstrated in the development plan and supporting evidence base. Furthermore, the applicant fails to accurately demonstrate that there&amp;nbsp;is an identified need for the children&#x27;s home,&amp;nbsp;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif;&quot;&gt;which&amp;nbsp;would not meet the current needs of LBBD Children’s Social Care, according to&amp;nbsp;LBBD&#x27;s Lead Commissioner in Children&#x27;s Social Care&lt;/span&gt;. As such, the proposal is considered to have a detrimental impact on the borough&#x27;s supply of family housing and is contrary to the following policies:&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 11pt;&quot;&gt;National Planning Policy Framework (December 2024)&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 11pt;&quot;&gt;Policiy&amp;nbsp;D7, H1, H12 and S2 of the London Plan (March 2021)&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 11pt;&quot;&gt;Policies SP3 and&amp;nbsp;SPDG1 of the Barking and Dagenham Local Plan 2037 (September 2024)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;"
  ],
