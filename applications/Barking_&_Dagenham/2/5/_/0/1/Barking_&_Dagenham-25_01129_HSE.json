  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-family:Arial,Helvetica,sans-serif&quot;&gt;&lt;span style=&quot;font-size:11pt&quot;&gt;The proposed hip-to-gable roof extension would&amp;nbsp;constitute overdevelopment of the dwelling, which&amp;nbsp;already&amp;nbsp;represents the maximum permissible development at its modest corner plot location, as well as unbalancing the symmetry across the host terrace row&amp;nbsp;and appearing at odds with the established character and appearance of the surrounding area. This is particularly detrimental given the application site&#x27;s prominent corner plot position within the street scene.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;As such, the proposed development is contrary to:&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;p&gt;&lt;span pt=&quot;&quot; sans&quot;,=&quot;&quot; sans-serif;&quot;=&quot;&quot;&gt;- National Planning Policy Framework&amp;nbsp;&lt;/span&gt;National Planning Policy Framework (NPPF) (December 2024);&amp;nbsp; -Policies D1, D4, D5 and D6 of the London Plan (March 2021)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; -Policies DMD1 and SP2&amp;nbsp;&lt;span pt=&quot;&quot; sans&quot;,=&quot;&quot; sans-serif;&quot;=&quot;&quot;&gt;of t&lt;/span&gt;he London Borough of Barking and Dagenham’s Local Plan (September 2024);&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - The London Borough of Barking and Dagenham’s Residential Extensions and Alterations SPD (February 2012).&lt;/p&gt;&lt;/div&gt;"
