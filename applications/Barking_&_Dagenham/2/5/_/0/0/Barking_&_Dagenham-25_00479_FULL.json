{
  "borough": "London Borough of Barking and Dagenham",
  "application_type": "All Other",
  "decision": "Approved",
  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-size: 14.6667px;&quot;&gt;The works to which this consent relates must be begun not later than the expiration of three years beginning with the date on which consent is hereby granted.&lt;/span&gt;&lt;/p&gt;",
    "&lt;p&gt;The development hereby approved shall only be carried out in accordance with the following approved plans and documents:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Garden Plan General Arrangement&amp;nbsp;- drawing no. AD01 Revision F - dated November 2024&lt;/li&gt;&lt;li&gt;Service Building Plan General Arrangement - drawing no. AD02 Revision B - dated November 2024&lt;/li&gt;&lt;li&gt;Proposed Eastern Elevation - dated 26th August 2025&lt;/li&gt;&lt;li&gt;Site Location Plan&lt;/li&gt;&lt;li&gt;Stoneford Cottage Proposed Amenity Building Design Access and Heritage Statement - dated April 2025&amp;nbsp;&lt;/li&gt;&lt;li&gt;Urban Greening Factor Calculator&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;No other drawings or documents apply.&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-size: 11pt;&quot;&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif;&quot;&gt;Prior to commencement of the development, the following must be submitted to, approved in writing by, the LPA:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 11pt;&quot;&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif;&quot;&gt;Full details of external materials including fenestration (type, colour, finish, manufacturer).&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 11pt;&quot;&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif;&quot;&gt;Details of the access ramp including external finishes and any handrails (noted on the drawings as TBA and also noted within the Design and Access Statement).&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 11pt;&quot;&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif;&quot;&gt;Details of hard landscaping&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;",
    "&lt;p&gt;The proposed development shall achieve security standards (based on Secured by Design principles) to \r\nthe satisfaction of the local authority &amp;amp; Metropolitan Police, details of which shall be provided to the \r\nLocal Planning Authority for its written approval prior to the first occupation of the approved \r\ndevelopment. All security measures applied to the approved development shall be permanently \r\nretained thereafter.&amp;nbsp;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-size: 11pt;&quot;&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif;&quot;&gt;The proposed development must involve the i&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif; font-size: 11pt;&quot;&gt;nstallation of&amp;nbsp;heritage style signature close to the entrance to explain the history of the site and Mary White&#x27;s legacy.&lt;/span&gt;&lt;/p&gt;"
  ],
