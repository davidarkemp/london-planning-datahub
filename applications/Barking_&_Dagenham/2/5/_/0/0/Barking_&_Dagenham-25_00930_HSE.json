{
  "borough": "London Borough of Barking and Dagenham",
  "application_type": "Householder",
  "decision": "Refused",
  "decision_conditions": [
    "<div><span style=\"font-size: 11pt;\">The proposed extension, by reason of its excessive bulk, mass, scale, siting, and unsympathetic design, &nbsp;</span><span style=\"font-size: 11pt;\">would appear as an incongruous and dominant addition that fails to respect the architectural character of the host dwelling or the established streetscape, closing off the corner plot. The fragmented roofscape, comprising misaligned roof forms including a flat roof element projecting beyond a hipped upper storey, would lack cohesion and architectural integrity, further reinforcing the visual discordance of the scheme. This would pose significant harm to the character of the dwelling and wider area which is notable given the sites location within the Becontree Estate.</span>&nbsp;As such, the proposed development is contrary to:<br></div><div><br></div><div><p><span style=\"font-size: 10.5pt; font-family: \" pt=\"\" sans\",=\"\" sans-serif;\"=\"\">-\r\nNational Planning Policy Framework </span>(NPPF) (MHCLG, December 2024)<o:p></o:p></p><p class=\"MsoNormal\"><span style=\"font-size: 10.5pt; line-height: 107%; font-family: \" pt=\"\" sans\",=\"\" sans-serif;\"=\"\">- Policy D4 of the\r\nLondon Plan (March 2021)</span></p><p class=\"MsoNormal\"><span style=\"font-size: 10.5pt; line-height: 107%; font-family: \" pt=\"\" sans\",=\"\" sans-serif;\"=\"\">- The Residential\r\nExtensions and Alterations Supplementary Planning Document (February 2012)<o:p></o:p></span></p><p class=\"MsoNormal\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n</p><p><b><span style=\"font-size: 10.5pt; font-family: \" pt=\"\" sans\",=\"\" sans-serif;\"=\"\">- </span></b><span style=\"font-size: 10.5pt; font-family: \" pt=\"\" sans\",=\"\" sans-serif;\"=\"\">Policies SP2,&nbsp; SPP6, DMD1, DMD4 and DMD5 of </span>The London Borough of\r\nBarking and Dagenham’s Local Plan (September 2024)<o:p></o:p></p></div>"
  ],
