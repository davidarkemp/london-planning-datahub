{
  "borough": "London Borough of Barking and Dagenham",
  "application_type": "Householder",
  "decision": "Refused",
  "decision_conditions": [
    "<div><span style=\"font-size: 11pt;\">The bulk, mass, scale, siting and design of the proposed first floor side extension would present an undesirable addition to the dwelling, which would close off the openness of the corner plot, unbalance the symmetry and uniformity of the terrace row and create a fragmented, dicordant roof form, thus impacting the character of the area, notably given the location of the application site within the Becontree Estate.</span>. As such, the proposed development is contrary to:<br></div><div><br></div><div><p><span style=\"font-size: 10.5pt; font-family: \" pt=\"\" sans\",=\"\" sans-serif;\"=\"\">-\r\nNational Planning Policy Framework</span>&nbsp;(NPPF) (MHCLG, December 2024)<o:p></o:p></p><p class=\"MsoNormal\"><span style=\"font-size: 10.5pt; line-height: 107%; font-family: \" pt=\"\" sans\",=\"\" sans-serif;\"=\"\">- Polies D4 and HC1 of the\r\nLondon Plan (March 2021)</span></p><p class=\"MsoNormal\"><span style=\"font-size: 10.5pt; line-height: 107%; font-family: \" pt=\"\" sans\",=\"\" sans-serif;\"=\"\">- The Residential\r\nExtensions and Alterations Supplementary Planning Document (February 2012)<o:p></o:p></span></p><p class=\"MsoNormal\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n</p><p><b><span style=\"font-size: 10.5pt; font-family: \" pt=\"\" sans\",=\"\" sans-serif;\"=\"\">- </span></b><span style=\"font-size: 10.5pt; font-family: \" pt=\"\" sans\",=\"\" sans-serif;\"=\"\">Policies SP2, SPP6 DMD1, DMD4 and DMD5 of </span>the London Borough of\r\nBarking and Dagenham’s Local Plan (September 2024)</p></div>"
  ],
