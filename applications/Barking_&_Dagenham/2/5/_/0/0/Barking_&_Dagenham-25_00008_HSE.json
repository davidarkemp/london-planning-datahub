  "decision_conditions": [
    "The development hereby permitted shall be commenced before the expiration of three years from the date of this permission.<br>",
    "<p class=\"MsoNormal\">The materials to be used in the construction of the external surfaces of the development hereby permitted shall match those used in the existing dwellinghouse.<br></p>",
    "&lt;p&gt;The garage hereby approved shall only be used for purposes incidental to the enjoyment of the dwellinghouse as such. It shall not be used for purposes conflicting with the use of the property as a single dwellinghouse, and in particular it shall not be used as a separate unit of accommodation.&lt;/p&gt;",
    "&lt;p&gt;The development hereby approved shall only be carried out in accordance with the following approved plans and documents:&lt;/p&gt;&lt;p&gt;- 2 Lyndhurst Gardens/300/2/4 Proposed Garage 12/2024&lt;br&gt;- 2 Lyndhurst Gardens/300/3/4 Proposed Garage 12/2024&lt;br&gt;- 2 Lyndhurst Gardens/300/4/4 Proposed Garage 12/2024&lt;br&gt;- 2 Lyndhurst Gardens/600/1/1 Site Location and Block Plan (as built) 12/2024&lt;/p&gt;&lt;p&gt;No other drawings or documents apply.&lt;/p&gt;"
  ],
