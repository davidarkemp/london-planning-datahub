  "decision_conditions": [
    "The development hereby permitted shall be commenced before the expiration of three years from the date of this permission.<br>",
    "&lt;p&gt;The development hereby approved shall only be carried out in accordance with the following approved plans and documents:&lt;/p&gt;&lt;p&gt;- HP-GR-01 Existing Block Plan January 2025&lt;br&gt;- HP-GR-010 Existing Outbuilding Plan and Elevation January 2025&lt;br&gt;&lt;/p&gt;&lt;p&gt;No other drawings or documents apply.&lt;/p&gt;",
    "<p class=\"MsoNormal\">The materials to be used in the construction of the external surfaces of the development hereby permitted shall match those used in the existing dwellinghouse.<br></p>",
    "<p>The outbuilding hereby approved shall only be used for purposes incidental to the enjoyment of the dwellinghouse as such. It shall not be used for purposes conflicting with the use of the property as a single dwellinghouse, and in particular it shall not be used as a separate unit of accommodation.</p>"
