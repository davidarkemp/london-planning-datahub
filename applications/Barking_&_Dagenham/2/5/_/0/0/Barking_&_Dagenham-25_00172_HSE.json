{
  "borough": "London Borough of Barking and Dagenham",
  "application_type": "Householder",
  "decision": "Refused",
  "decision_conditions": [
    "<p style=\"\">The proposed development, by reason of siting, scale, mass, bulk and design, would present a discordant addition which would disrupt the rhythm and symmetry of the street, would result in the loss of open aspect to the corner plot, would appear overly bulky and would have a discordant roof form. This would cause unacceptable harm to the character and appearance of the original dwelling and surrounding area.&nbsp;The proposal is therefore found to be at odds with the following policies which seek to ensure that development proposals are of a high quality design and&nbsp;have regard to the existing character:</p><ul><li style=\"\">National Planning Policy Framework (NPPF) (December, 2024)</li><li style=\"\">Policy D4 of the London Plan (March 2021)</li><li style=\"\">Residential Extensions and Alterations Supplementary Planning Document (February 2012)</li><li style=\"\">Policies SP2, DMD1 and DMD5 of The Barking and Dagenham Local Plan (September&nbsp;2024)</li></ul>"
  ],
