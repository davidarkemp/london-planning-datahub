  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;\r\nfont-family:&amp;quot;Aptos&amp;quot;,sans-serif;mso-ascii-theme-font:minor-latin;mso-fareast-font-family:\r\nAptos;mso-fareast-theme-font:minor-latin;mso-hansi-theme-font:minor-latin;\r\nmso-bidi-font-family:&amp;quot;Times New Roman&amp;quot;;mso-bidi-theme-font:minor-bidi;\r\nmso-ansi-language:EN-GB;mso-fareast-language:EN-US;mso-bidi-language:AR-SA&quot;&gt;The proposed\r\nuse of a room on the ground floor as a private car hire booking office through\r\nthe use of telephone and computer bookings would not result in a material\r\nchange of use of the dwellinghouse. Planning permission would not therefore be\r\nrequired to use a part of the dwellinghouse in the manner the applicant has\r\ndescribed.&lt;/span&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;\r\nfont-family:&amp;quot;Aptos&amp;quot;,sans-serif;mso-ascii-theme-font:minor-latin;mso-fareast-font-family:\r\nAptos;mso-fareast-theme-font:minor-latin;mso-hansi-theme-font:minor-latin;\r\nmso-bidi-font-family:&amp;quot;Times New Roman&amp;quot;;mso-bidi-theme-font:minor-bidi;\r\nmso-ansi-language:EN-GB;mso-fareast-language:EN-US;mso-bidi-language:AR-SA&quot;&gt;The proposal\r\nis therefore a lawful development.&lt;/span&gt;&lt;/p&gt;"
