  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;text-align: justify;&quot;&gt;&amp;nbsp;The proposal is NOT therefore a lawful development.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;line-height: 150%;&quot;&gt;The dwellinghouse had been unlawfully converted into three self-contained flats without planning permission. As such the permission granted by Schedule 2 does not apply under the Article 3(5) of the Town and Country Planning (General Permitted Development) (England) Order 2015 (as amended).&lt;/span&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;line-height: 150%;&quot;&gt;Notwithstanding reason 1, by reason of inaccurate and inconsistent plans with the written description of the development, the Local Planning Authority is unable to make an accurate and comprehensive assessment of the proposal.&amp;nbsp;The proposal is therefore contrary to Schedule 2, Part 1, Class A, condition A.4 (3) (a) and (b) of the Town and Country Planning (General Permitted Development) (England) Order 2015 as amended.&lt;/span&gt;&lt;/p&gt;"
  ],
