  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;\r\nfont-family:&amp;quot;Aptos&amp;quot;,sans-serif;mso-ascii-theme-font:minor-latin;mso-fareast-font-family:\r\nAptos;mso-fareast-theme-font:minor-latin;mso-hansi-theme-font:minor-latin;\r\nmso-bidi-font-family:&amp;quot;Times New Roman&amp;quot;;mso-bidi-theme-font:minor-bidi;\r\nmso-ansi-language:EN-GB;mso-fareast-language:EN-US;mso-bidi-language:AR-SA&quot;&gt;The\r\nproposal would meet the definition of a caravan as defined by both the Caravan\r\nSites and Control of Development Act 1960 and the Caravan Sites Act 1968.&amp;nbsp; It would also be used for purposes incidental\r\nto the enjoyment of the existing dwellinghouse at 55 Shaftesbury Avenue, South Harrow, HA2 0PL. The proposal would therefore not require planning permission as it would\r\nnot constitute development under the terms of Section 55 of the Town and\r\nCountry Planning Act 1990.&lt;/span&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;\r\nfont-family:&amp;quot;Aptos&amp;quot;,sans-serif;mso-ascii-theme-font:minor-latin;mso-fareast-font-family:\r\nAptos;mso-fareast-theme-font:minor-latin;mso-hansi-theme-font:minor-latin;\r\nmso-bidi-font-family:&amp;quot;Times New Roman&amp;quot;;mso-bidi-theme-font:minor-bidi;\r\nmso-ansi-language:EN-GB;mso-fareast-language:EN-US;mso-bidi-language:AR-SA&quot;&gt;The\r\nproposal is therefore a lawful development.&lt;/span&gt;&lt;/p&gt;"
  ],
