  "decision_conditions": [
    "&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-family:&amp;quot;Arial&amp;quot;,sans-serif;mso-bidi-font-family:&amp;quot;Times New Roman&amp;quot;&quot;&gt;The\r\nproposal, by reason of failure to demonstrate&amp;nbsp;sufficient bedroom space, has failed to demonstrate that the unit would be providing an\r\noverall acceptable standard of living accommodation. The proposed development\r\nwould therefore give rise to substandard and poor quality accommodation to the\r\ndetriment of the residential amenities of the existing and future occupiers of\r\nthe unit, contrary to policies&amp;nbsp; DM26&amp;nbsp;(c)&amp;nbsp;of the Harrow\r\nDevelopment Management Policies Local Plan (2013), The London Planning Guidance\r\n- Housing Design Guide (June 2023) Draft\r\nNew Local Plan (2021-2041)&amp;nbsp;GR1, HO2&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;",
    "&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-family:&amp;quot;Arial&amp;quot;,sans-serif;mso-bidi-font-family:&amp;quot;Times New Roman&amp;quot;&quot;&gt;The\r\nproposal, by reason of failure to demonstrate a sufficient overall Gross\r\nInternal floor Area (GIA), built-in storage space and in the absence of a\r\nproposed section drawing detailing the internal head heights of unit and a\r\nfirst floor plan, has failed to demonstrate that the unit would be\r\nproviding an overall acceptable standard of living accommodation. The proposed\r\ndevelopment would therefore give rise to substandard and poor quality\r\naccommodation to the detriment of the residential amenities of the existing and\r\nfuture occupiers of the unit, contrary to policies DM1 C, DM1 D (g), DM26 A\r\n(a), and (c), and DM26 E of the Harrow Development Management Policies Local\r\nPlan (2013) and Draft New Local Plan\r\n(2021-2041)&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;GR1, HO2&lt;/span&gt;&lt;/p&gt;"
  ],
