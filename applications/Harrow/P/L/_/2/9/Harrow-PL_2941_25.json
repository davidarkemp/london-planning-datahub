  "decision_conditions": [
    "&lt;p&gt;The use hereby permitted shall be discontinued and the land restored to its former condition within 5 years of the date of this permission, in accordance with a scheme of work submitted to, and approved by, the local planning authority.&lt;/p&gt;",
    "&lt;p&gt;The development hereby permitted shall be carried out in accordance with the following approved plans and documents:&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;EBP01-4CRWS- Block Plan, SL01-4CRWS – Site Location Plan, EX01-4CRWS Rev A, PROP01-4CRWS Rev B, PROP02-4CRWS, Cover Letter (Lichfields 12 November 2025), Planning Statement (Lichfields 12 November 2025), Surface Water Flood Risk Technical Note (Pell Frischmann 10/03/2026)&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;",
    "&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; line-height: 20px;&quot;&gt;&lt;div style=&quot;line-height: 20px;&quot;&gt;&lt;p&gt;No external lighting shall be installed on the site until a detailed lighting scheme has been submitted to and approved in writing by the Local Planning Authority. &lt;/p&gt;&lt;p&gt;The lighting scheme shall include:&lt;/p&gt;&lt;p&gt;a) the location, height, design and specification of each light;&lt;br&gt;b) light spillage levels (lux contours) at the site boundaries;&lt;br&gt;c) measures to prevent light glare and overspill beyond the site; and&lt;br&gt;d) details of lighting controls, including hours of operation and any sensor or timer arrangements.&lt;/p&gt;&lt;p&gt;The approved lighting scheme shall be installed in full prior to the first use of the development and thereafter retained and maintained in accordance with the approved details for the lifetime of the development.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;"
  ],
