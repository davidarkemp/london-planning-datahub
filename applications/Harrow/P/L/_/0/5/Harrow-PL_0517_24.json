  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;line-height:normal&quot;&gt;Insufficient details have been provided to demonstrate that the proposed structure is a mobile home pursuant to the&amp;nbsp;Caravan Sites and Control of Development Act 1960 and the Caravan Sites Act 1968, it also appears that operational development is underway on the site.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;line-height:normal&quot;&gt;The proposal would therefore require planning permission as it would constitute development under the terms of Section 55 of the Town and Country Planning Act 1990.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;line-height: 107%;&quot;&gt;The proposal is therefore NOT a lawful\r\ndevelopment.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;"
