  "decision_conditions": [
    "&lt;p&gt;The documents/information submitted, in the absence of any substantive conflicting evidence, is satisfactory to prove, on the balance of probabilities, that the side extension attached to the main dwelling at&amp;nbsp;44 The Highway, Stanmore, Harrow, HA7 3PN,&amp;nbsp; has been in use as an annexe for a continuous period of at least 4 years prior to the date of this application.&amp;nbsp;&amp;nbsp;The use as an annexe&amp;nbsp;is therefore immune from enforcement action and is lawful under Section 191 of the Town and Country Planning Act 1990 (as amended).&amp;nbsp;&lt;/p&gt;"
