{
  "borough": "Harrow",
  "application_type": "All Other",
  "decision": "Refused",
  "decision_conditions": [
    "&lt;p class=&quot;MsoListParagraph&quot; style=&quot;margin-bottom: 0cm; line-height: normal;&quot;&gt;&lt;span style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; line-height: normal;&quot;&gt;The&amp;nbsp;&lt;/span&gt;proposed\r\nvehicular crossover would neither improve or maintain safety in the area due to\r\nthe proximity of the bus stop, the interruption of the pedestrian footway and\r\nthe close proximity to public cycle parking, which would harm the public and\r\ncycle safety of the immediate locale, contrary to Policy T4 of the London Plan\r\n(2021) and Policy DM42 of the Development Management DPD (2013).&amp;nbsp;&lt;span style=&quot;font-size: 12pt;&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;line-height: 115%;&quot;&gt;The proposed crossover would harm the visual character of\r\nthe host site and surrounding retail/commercial parade by reducing the pedestrian\r\nspace in the immediate locale and bringing about more vehicular parking in a\r\nspace characterised by pedestrian permeability, contrary to the high-quality\r\ndesign aspirations of the National Planning Policy Framework (2023), Policy D3\r\nand D8 of the London Plan (2021), and Policy DM1 of the Development Management\r\nDPD (2013).&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;"
  ],
