  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-size:11.0pt;font-family:&amp;quot;Arial&amp;quot;,sans-serif;\r\nmso-fareast-font-family:&amp;quot;Times New Roman&amp;quot;;mso-ansi-language:EN-GB;mso-fareast-language:\r\nEN-GB;mso-bidi-language:AR-SA&quot;&gt;The proposed hot food takeaway is unacceptable\r\nin principle as it would result in an increased hot\r\nfood takeaway provision in too close proximity to the nearby Welldon Park Academy,\r\ncontributing to childhood obesity within London, and forms part of an over concentration\r\nof hot food takeaways within the wider South Harrow District centre. This results in a use which would not be compatible\r\nwith Policy E9 of The London Plan (2021) and the healthy places\r\naspirations of the National Planning Policy Framework (2023).&lt;/span&gt;&lt;br&gt;&lt;/p&gt;"
