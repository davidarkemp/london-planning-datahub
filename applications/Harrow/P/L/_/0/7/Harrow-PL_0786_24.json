  "decision": "Refused",
  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;line-height:150%&quot;&gt;It has not been demonstrated that the materials used in the facing flank elevations of the rear dormer, when viewed from ground level, would appear to be of similar colour and design to the materials used in the main roof of the subject dwellinghouse. The proposed dormer would not therefore be within the tolerances of Schedule 2, Part 1 Class B, Condition B.2 (a) of The Town and Country Planning (General Permitted Development) (England) Order 2015 (as amended).&lt;/span&gt;&lt;br&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%;\r\nfont-family:&amp;quot;Arial&amp;quot;,sans-serif;mso-fareast-font-family:&amp;quot;Times New Roman&amp;quot;;\r\nmso-bidi-font-family:&amp;quot;Times New Roman&amp;quot;;mso-font-kerning:0pt;mso-ansi-language:\r\nEN-GB;mso-fareast-language:EN-US;mso-bidi-language:AR-SA&quot;&gt;The proposal is\r\ntherefore NOT a lawful development&lt;/span&gt;&lt;br&gt;&lt;/p&gt;"
  ],
