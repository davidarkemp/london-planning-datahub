{
  "borough": "Harrow",
  "application_type": "Householder",
  "decision": "Refused",
  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-size:11pt&quot;&gt;&lt;span style=&quot;font-family:Arial,Helvetica,sans-serif&quot;&gt;The proposed development, by reason of insufficient&amp;nbsp;information provided to appropriately evidence no harm would occur to the street&amp;nbsp;tree directly in front of the property and would not result in future pressure to fell the tree for quality reasons. As such, the development contrary to policy G7 of the London Plan (2021), Policy DM22 of the Development Management Policies (2013), and guidance in the Conservation Area Appraisal and Management Strategy - West Towers (2009).&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;",
    "&lt;span style=&quot;font-size:11pt&quot;&gt;&lt;span style=&quot;font-family:Arial,Helvetica,sans-serif&quot;&gt;The proposal, by reason of the partial removal of the low-level front boundary wall and alterations to the front forecourt including removal of landscaping, fails to preserve and enhance the character of the West Towers Conservation Area, contrary to London Plan Policy HC1 (2021), Core Strategy Policy CS1 (2012), Development Management Policies DM1 and DM7 (2013), and guidance in the Conservation Area Appraisal and Management Strategy - West Towers (2009).&lt;/span&gt;&lt;/span&gt;"
  ],
