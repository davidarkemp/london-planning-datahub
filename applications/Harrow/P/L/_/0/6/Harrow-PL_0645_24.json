{
  "borough": "Harrow",
  "application_type": "All Other",
  "decision": "Refused",
  "decision_conditions": [
    "&lt;ol start=&quot;1&quot; type=&quot;1&quot;&gt;\r\n &lt;li class=&quot;MsoNoSpacing&quot;&gt;The proposal, by reason of its failure&amp;nbsp;to provide\r\n     the minimum bedroom dimensions within the proposed ground floor flat\r\n     layout, in conjunction with the substandard width and siting of primary\r\n     entrance access,&amp;nbsp; substandard&amp;nbsp;access to the rear amenity space assigned to the first floor\r\n     flat, would all result in a cumulatively detrimental and\r\n     unacceptable&amp;nbsp;standard of living accommodation for future occupiers of\r\n     the two flats. As such, the development is contrary to Policies\r\n     D3&amp;nbsp;and D6, of the London Plan (2021), Policies DM 1 and DM 26 of the\r\n     Harrow Development Management Policies Local Plan (2013), The Mayor of\r\n     London Housing Supplementary Planning Guidance (2016), the adopted\r\n     Supplementary Planning Document: Residential Design Guide (2010), Housing\r\n     Design Standards LPG (2023) and the&amp;nbsp;National Planning Policy\r\n     Framework (2023).&amp;nbsp;&lt;o:p&gt;&lt;/o:p&gt;&lt;/li&gt;\r\n&lt;/ol&gt;"
  ],
