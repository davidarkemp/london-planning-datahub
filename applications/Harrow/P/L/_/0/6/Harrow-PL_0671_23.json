  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;line-height: 150%;&quot;&gt;The documents/information submitted, in the absence of any conflicting evidence, is satisfactory to prove, on the balance of probabilities, that the dwellinghouse at &lt;span style=&quot;line-height: 150%;&quot;&gt;15 Carlton Avenue, Kenton, Harrow, HA3 8AX&lt;/span&gt;, has been in use as two self-contained residential units for a continuous period of at least 4 years prior to the date of this application. The existing development is therefore considered to be lawful.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;line-height: 150%;&quot;&gt;The use of the dwellinghouse at &lt;span style=&quot;line-height: 150%;&quot;&gt;15 Carlton Avenue, Kenton, Harrow, HA3 8AX&lt;/span&gt;, as two self-contained residential units, is immune from enforcement action and is therefore lawful under S.171B of the Town and Country Planning Act 1990 (as amended).&lt;/span&gt;&lt;br&gt;&lt;/p&gt;"
