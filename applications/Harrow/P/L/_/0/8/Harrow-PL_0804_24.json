  "decision_conditions": [
    "&lt;p class=&quot;MsoNoSpacing&quot;&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;&quot;&gt;The Local Planning Authority is not satisfied that consistent evidence\r\nhas been provided to demonstrate that, on the balance of probabilities, the\r\nproperty at 23 Aberdeen Road, Wealdstone, Harrow, HA3 7NF, has been in use as &lt;/span&gt;four studio flats &lt;span lang=&quot;EN-US&quot; style=&quot;&quot;&gt;for a continuous period of at\r\nleast 4 years prior to the date of this application. The existing development\r\nis therefore considered to be unlawful and as such the Local Planning Authority\r\nrefuse to issue a Certificate of Lawful Existing Development.&lt;span style=&quot;font-size: 12pt;&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;"
