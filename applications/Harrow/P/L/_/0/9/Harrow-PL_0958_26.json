  "description": "Certificate of Lawful Proposed Development: Change of use from Professional services E(c)(ii) to Light industrial processes E(g)(iii)",
  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;color: rgb(51, 51, 51);&quot;&gt;The existing lawful use and the proposed use both&lt;/span&gt;&lt;span style=&quot;color: rgb(51, 51, 51);&quot;&gt;&amp;nbsp;falls within the same Use Class (Class E). As such the proposal does not amount to development as per section 55 of The Town and Country Planning Act 1990, as amended.&amp;nbsp; Planning permission is therefore not required.&lt;/span&gt;&lt;/p&gt;",
    "&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-size: 10.5pt; line-height: 107%; font-family: &amp;quot;PT Sans&amp;quot;, sans-serif; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;&quot;&gt;The proposal is therefore a\r\nlawful development&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;"
