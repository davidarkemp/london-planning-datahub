  "decision_conditions": [
    "&lt;p class=&quot;MsoListParagraphCxSpFirst&quot; style=&quot;margin-bottom: 0cm; line-height: 115%;&quot;&gt;&lt;span style=&quot;line-height: 115%;&quot;&gt;Insufficient\r\ninformation has been provided to the local planning authority to adequately\r\nassess the proposal in terms of &lt;/span&gt;&lt;span style=&quot;line-height: 115%;&quot;&gt;noise and disturbance upon surrounding land\r\nuses. The proposal is therefore contrary to the NPPF 2024, London Plan (2021)\r\npolicy D14 and Harrow Local Plan (2021-2041) policy GR1.&lt;/span&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;text-align: justify; line-height: 18.4px;&quot;&gt;The proposed electrical substation, due to its position and scale, would adversely impact upon outlook and light levels associated with ground floor residential accommodation at 12-22 Herga Road (Studio 0.6). &lt;/span&gt;&lt;span style=&quot;text-align: justify; line-height: 18.4px;&quot;&gt;The proposal is therefore contrary to the NPPF 2024, London Plan (2021) policy D11 and Harrow Local Plan (2021-2041) policy GR1.&lt;/span&gt;&lt;/p&gt;"
  ],
