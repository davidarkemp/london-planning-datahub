  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;line-height:150%&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span style=&quot;line-height:150%&quot;&gt;The applicant by reason of insufficient information has failed to demonstrate that the use or operations described in the application would be lawful within the meaning of S192 of the Town and Country Planning Act 1990 (as amended) if instituted or begun at the time of the application. Specifically the application fails to demonstrate the proposed use as an assisted living facility for up to 6 persons would fall within Use Class C3b of the Town and Country Planning (Use Classes) Order 1987 (England) (as amended).&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;",
    "&lt;p&gt;The proposal is therefore not a lawful development.&lt;/p&gt;"
