  "decision_conditions": [
    "&lt;p&gt;The proposal is therefore not a lawful development.&lt;/p&gt;",
    "&lt;span style=&quot;font-size:12.0pt;font-family:&amp;quot;Arial&amp;quot;,sans-serif;\r\nmso-fareast-font-family:&amp;quot;Times New Roman&amp;quot;;mso-bidi-font-family:&amp;quot;Times New Roman&amp;quot;;\r\nmso-font-kerning:0pt;mso-ansi-language:EN-GB;mso-fareast-language:EN-GB;\r\nmso-bidi-language:AR-SA&quot;&gt;The proposal by reason of the rear dormer not being\r\nfully contained within the rear roofslope, has not demonstrated that the\r\nmaterials used in the facing side elevations of the rear dormer, when viewed\r\nfrom ground level, would appear to be of similar colour and design to the\r\nmaterials used in the main roof of the subject dwellinghouse. The proposed\r\ndevelopment would not therefore be within the tolerances of Schedule 2, Part 1,\r\nClass B, B.2 (a) of The Town and Country Planning (General Permitted Development)\r\n(England) Order 2015 as amended&lt;/span&gt;"
  ],
