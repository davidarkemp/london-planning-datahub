  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;line-height: 107%;&quot;&gt;The proposal is therefore not a lawful\r\ndevelopment&lt;/span&gt;&lt;br&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;line-height: 107%;&quot;&gt;The side of the proposed rear dormer would be\r\nflush with the existing side wall and therefore it has not been demonstrated\r\nthat the materials used in the facing side elevations of the rear dormer, when\r\nviewed from ground level, would appear to be of similar colour and design to\r\nthe materials used in the main roof of the subject dwellinghouse. The proposed\r\ndevelopment would not therefore be within the tolerances of Schedule 2, Part 1,\r\nClass B, B.2 (a) of The Town and Country Planning (General Permitted\r\nDevelopment) (England) Order 2015 as amended.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;"
  ],
