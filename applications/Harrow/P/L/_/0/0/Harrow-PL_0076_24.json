{
  "borough": "Harrow",
  "application_type": "Householder",
  "decision": "Refused",
  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;line-height: normal;&quot;&gt;The proposed part single part two storey&amp;nbsp;side to rear extension by&amp;nbsp;reason of the first floor rear element&#x27;s failure to be sufficiently set in from&amp;nbsp;the flank wall of the first floor side element on a prominent end site, would introduce an excessively bulky and prominent extended flank wall which would unduly&amp;nbsp;detract from views afforded along the street scene.&amp;nbsp;In failing to incorporate a roof form that would be sufficiently set down from the ridge of the main dwelling, the first floor side element would appear as&amp;nbsp;an insubordinate and incongruous&amp;nbsp;addition to the host dwelling. Furthermore, the incorporation of a second entrance door to the front elevation of the property through the ground floor side element&amp;nbsp;is considered to appear unduly at odds with the established pattern of development along the street scene.&amp;nbsp;The proposed development would thereby be contrary to the high quality design aspirations of the&lt;/span&gt;&lt;span style=&quot;line-height: normal;&quot;&gt;&amp;nbsp;National Planning Policy Framework (2023), Policies&amp;nbsp;D3 (D(1) and (11)) of The&amp;nbsp; London Plan (2021), Core Policy CS1.B of the Harrow Core Strategy (2012), Policies&amp;nbsp;DM1 A, DM1 B (a), (b) and (c) of the Harrow Development Management Policies Local Plan (2013) and the adopted Supplementary Planning Document: Residential Design Guide (2010).&lt;/span&gt;&lt;br&gt;&lt;/p&gt;"
  ],
