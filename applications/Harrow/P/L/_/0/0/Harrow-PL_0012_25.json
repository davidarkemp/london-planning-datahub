  "decision": "Refused",
  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;The proposal, by reason of failure to demonstrate a sufficient overall Gross Internal floor Area (GIA) to F&lt;/span&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;text-indent: -18pt; font-family: Arial, sans-serif;&quot;&gt;lats B and D, in addition to failing to provide details regarding external amenity space, and\r\ninternal stacking concerns, would offer a substandard and cramped form of\r\naccommodation for future occupiers to the detriment of their living conditions.\r\nThe development is thereby contrary to the high quality design aspirations of\r\nthe National Planning Policy Framework (2024), Policies D3 and D6 of The London\r\nPlan (2021), Policies DM1, DM26 and DM27 of the Harrow Development Management\r\nPolicies Local Plan (2013); the adopted Supplementary Planning Documents\r\nResidential Design Guide (2010) and the Housing Design Standards LPG (2023).&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoListParagraph&quot; style=&quot;margin-left:36.0pt;text-indent:-18.0pt;\r\nmso-list:l0 level1 lfo1&quot;&gt;&lt;span lang=&quot;EN-US&quot; style=&quot;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-family: Arial, sans-serif;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;"
  ],
