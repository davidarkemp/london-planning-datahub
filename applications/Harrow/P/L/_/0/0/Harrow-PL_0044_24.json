{
  "borough": "Harrow",
  "application_type": "All Other",
  "decision": "Refused",
  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;line-height:normal&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;The proposal, by reason of failure to demonstrate&amp;nbsp;sufficient combined living, kitchen and dining space, the proposal has failed to demonstrate that the unit would be providing an overall acceptable standard of living accommodation. The proposed development would therefore give rise to substandard and poor quality accommodation to the detriment of the residential amenities of the existing and future occupiers of the unit, contrary to policies&amp;nbsp; DM26&amp;nbsp;(c)&amp;nbsp;of the Harrow Development Management Policies Local Plan (2013), The London Planning Guidance - Housing Design Guide (June 2023)&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;line-height:normal&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;The proposed plans fail to demonstrate the vehicle crossover would allow for the proposed configuration of parking spaces together with the lack of accessibility from the main road, would contrary to the high quality design aspirations of the National Planning Policy Framework (2023), Policy D3.D.1 and D.11 of The London Plan (2021), Policy CS1.B of the Harrow Core Strategy (2012), Policy DM1 of the Development Management Plan Local Policies (2013) and the adopted Supplementary Planning Document: Residential Design Guide (2010).&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;"
  ],
