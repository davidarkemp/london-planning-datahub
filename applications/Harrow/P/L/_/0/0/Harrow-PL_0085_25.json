  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;line-height: 115%;&quot;&gt;The\r\nproposed use of the garage as a dog\r\ngrooming business (Sui Generis) for up to three clients per day on an appointment only basis, operating Monday\r\nto Friday with one member of staff who is a resident of the subject\r\ndwellinghouse would be ancillary to the main use of the property as a single\r\nfamily dwellinghouse. The proposal would therefore not result in a material\r\nchange of use of the dwellinghouse (Class C3) and would therefore be within the\r\ntolerances of The Town and Country Planning (Use Classes) Order 1987 as\r\namended.&lt;/span&gt;&lt;/p&gt;",
    "&lt;p&gt;&lt;span style=&quot;line-height: 115%;&quot;&gt;The\r\nproposal is therefore a lawful development&lt;/span&gt;&lt;/p&gt;"
