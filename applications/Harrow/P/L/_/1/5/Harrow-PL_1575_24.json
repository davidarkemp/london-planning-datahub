  "decision_conditions": [
    "&lt;p class=&quot;MsoNormal&quot; style=&quot;mso-margin-top-alt:auto;mso-margin-bottom-alt:auto;\r\nline-height:normal&quot;&gt;The Local Planning Authority is not satisfied that sufficient evidence\r\nhas been provided to demonstrate that, on the balance of probabilities, the\r\nproperty at Parkfield House, 15 Parkfield Road, South Harrow, has been in use\r\nas a dwellinghouse for a continuous period of at least 4 years prior to the\r\ndate of this application. The existing development is therefore considered to\r\nbe unlawful and as such the Local Planning Authority refuse to issue a\r\nCertificate of Lawful Existing Development.&lt;font face=&quot;Arial, sans-serif&quot;&gt;&lt;span style=&quot;font-size: 12pt;&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;"
