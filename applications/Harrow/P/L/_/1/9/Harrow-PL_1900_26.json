  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:&amp;quot;PT Sans&amp;quot;,sans-serif;\r\nmso-fareast-font-family:&amp;quot;Times New Roman&amp;quot;;mso-fareast-theme-font:minor-fareast;\r\nmso-bidi-font-family:&amp;quot;Times New Roman&amp;quot;;mso-ansi-language:EN-GB;mso-fareast-language:\r\nEN-GB;mso-bidi-language:AR-SA&quot;&gt;On the basis of the evidence submitted and on\r\nthe balance of probabilities, the use of the ground floor of the Rising Sun\r\nHotel, 138 Greenford Road, Sudbury, Harrow, HA1 3QL as a restaurant for a\r\ncontinuous period of at least 10 years prior to the date of this application.\r\nThe restaurant use is therefore immune from enforcement action under S.171B of\r\nthe Town and Country Planning Act 1990 (as amended) and is lawful under Section\r\n191 of the Town and Country Planning Act 1990 (as amended).&lt;/span&gt;&lt;/p&gt;"
  ]
