{
  "borough": "Harrow",
  "application_type": "Householder",
  "decision": "Refused",
  "decision_conditions": [
    "&lt;ol style=&quot;margin-top:0cm&quot; start=&quot;1&quot; type=&quot;1&quot;&gt;\r\n &lt;/ol&gt;&lt;p&gt;The\r\n     proposed&amp;nbsp;single and two storey rear extension by reason of its\r\n     excessive depth adjacent to the shared boundary with No.34, would result\r\n     in an unacceptable and unreasonable level of harm to the residential\r\n     amenities of the occupiers of No.34 Eastcote Avenue. The development would\r\n     cause significant overshadowing, loss of daylight, an increased sense of\r\n     enclosure, and an overbearing visual impact, contrary to The NPPF (2024), Policy\r\n     DM1 of the Harrow Development Management Policies Local Plan (2013),\r\n     Policy D3 of the London Plan (2021), and the provisions of the Harrow\r\n     Residential Design Guide SPD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/p&gt;&lt;ol style=&quot;margin-top:0cm&quot; start=&quot;1&quot; type=&quot;1&quot;&gt;\r\n&lt;/ol&gt;",
    "&lt;ol style=&quot;margin-top:0cm&quot; start=&quot;1&quot; type=&quot;1&quot;&gt;\r\n &lt;/ol&gt;&lt;p&gt;The\r\n     proposed development is located within surface water flood zones 3ahigh\r\n     &amp;amp; 3b medium. In the absence of a satisfactory Flood Risk Assessment,\r\n     it has not been demonstrated that the proposed development would not\r\n     exacerbate the risk of flooding within the site or increase the risk and\r\n     consequences of flooding elsewhere, contrary to National Planning Policy\r\n     Framework (2024), Policy SI 12 of The London Plan (2021), Core Policy\r\n     CS1.U of the Harrow Core Strategy (2012) and Policies DM9 and DM10 of the\r\n     Harrow Development Management Policies Local Plan (2013).&lt;o:p&gt;&lt;/o:p&gt;&lt;/p&gt;&lt;ol style=&quot;margin-top:0cm&quot; start=&quot;1&quot; type=&quot;1&quot;&gt;\r\n&lt;/ol&gt;"
  ],
