  "date_building_work_completed_under_previous_permission": null,
  "lapsed_date": "27/08/2029",
  "decision_conditions": [
    "&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font face=&quot;Arial, sans-serif&quot;&gt;The proposal, by reason of its failure to provide a 3-bedroom, 4 person family-size unit, combined with its low Public Transport Accessibility Level (PTAL) rating and the original internal floor area of the existing dwelling being less than 130sqm, would have a detrimental impact on the character, stock of family sized housing and amenity of local areas, contrary to HO2 of the Harrow Local Plan (2021-2041).&lt;/font&gt;&lt;/div&gt;",
    "&lt;p&gt;&lt;span style=&quot;font-size:11pt&quot;&gt;&lt;span arial=&quot;&quot;&gt;The proposed garage conversion into a single storey dwellinghouse&lt;/span&gt;&lt;span arial=&quot;&quot;&gt;, by reason of &lt;/span&gt;&lt;span arial=&quot;&quot;&gt;its&lt;/span&gt;&lt;span arial=&quot;&quot;&gt; location in the rear garden, would result in Garden Land development, and would be out of character and at odds with the layout of the dwellings and pattern of development in the surrounding area, and would result in an unacceptable loss of privacy to the future occupiers of the dwellinghouse due to its siting adjacent to the public highway contrary to the high quality design aspirations of the National Planning Policy Framework (20&lt;/span&gt;&lt;span arial=&quot;&quot;&gt;26&lt;/span&gt;&lt;span arial=&quot;&quot;&gt;), policy D3.D&lt;/span&gt;&lt;span arial=&quot;&quot;&gt; (1), (&lt;/span&gt;&lt;span arial=&quot;&quot;&gt;7&lt;/span&gt;&lt;span arial=&quot;&quot;&gt;)&lt;/span&gt;&lt;span arial=&quot;&quot;&gt; and &lt;/span&gt;&lt;span arial=&quot;&quot;&gt;(&lt;/span&gt;&lt;span arial=&quot;&quot;&gt;11&lt;/span&gt;&lt;span arial=&quot;&quot;&gt;)&lt;/span&gt;&lt;span arial=&quot;&quot;&gt; of The London Plan (2021), policies GR1 and GR10 of the Harrow Local Plan (2021-2041) and the adopted Supplementary Planning Document: Residential Design Guide (2010).&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;"
  ],
