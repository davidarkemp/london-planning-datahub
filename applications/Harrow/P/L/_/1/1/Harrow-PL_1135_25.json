  "borough": "Harrow",
  "application_type": "All Other",
  "decision": "Refused",
  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;line-height: 115%;&quot;&gt;It has\r\nnot been demonstrated to the satisfaction of the Local Planning Authority that\r\nthe use or operations described in the application would be lawful within the\r\nmeaning of S192 of the Town and Country Planning Act 1990 (as amended) if\r\ninstituted or begun at the time of the application. Specifically, the proposed\r\nuse of the dwellinghouse as a residential care facility for local children with\r\nlearning disabilities would result in a material change of use from Class C3\r\n(Dwellinghouse) to Use Class C2 and would therefore not be within the\r\ntolerances of the Town and Country Planning (Use Class) Order 1987 (as\r\namended).&amp;nbsp;&lt;/span&gt;The proposal is therefore not a lawful development.&amp;nbsp;&lt;/p&gt;"
  ],
