{
  "borough": "Harrow",
  "application_type": "All Other",
  "decision": "Refused",
  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;The proposed development, by reason of its prominent siting, excessive scale and poor design and architecture,&amp;nbsp;would result in&amp;nbsp;an incongruous,&amp;nbsp;bulky and contrived roof form with an awkward junction to the original building and would be out of character and would fail to respect the&amp;nbsp;established pattern of development within the Roxeth Hill Conservation Area.&amp;nbsp;The proposal would therefore be&amp;nbsp;harmful to the Roxeth Hill Conservation Area and character and appearance of the locality and there is no clear and convincing justification or public benefits&amp;nbsp; which would outweigh&amp;nbsp;the harm, contrary to the high-quality design aspirations of the National Planning Policy Framework (2023), Policies D3 D.1, D.11&amp;nbsp;and D.12&amp;nbsp;and HC1 C of the London Plan (2021); policy CS.1 B and D of the Harrow Core Strategy (2012), Policies DM1 and DM7 of the Development Management Plan Local Policies (2013), the adopted Supplementary Planning Document: Residential Design Guide (2010) and the Roxeth Hill Conservation Area Appraisal and Management Strategy (2008).&lt;/span&gt;&lt;br&gt;&lt;/p&gt;"
  ],
