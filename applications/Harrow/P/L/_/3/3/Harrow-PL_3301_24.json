  "decision_conditions": [
    "&lt;p class=&quot;MsoNoSpacing&quot;&gt;The retention and use of the Gazebo\r\nat Cornermount Mount Park Road, Harrow\r\nOn The Hill, Harrow, HA1 3LB, is immune from enforcement action and is\r\ntherefore lawful under S.171B of the Town and Country Planning Act 1990 (as\r\namended).&lt;o:p&gt;&lt;/o:p&gt;&lt;/p&gt;",
    "&lt;p class=&quot;MsoNoSpacing&quot;&gt;&lt;span lang=&quot;EN-US&quot;&gt;The documents/information submitted, in the absence of\r\nany conflicting evidence, is satisfactory to prove, on the balance of\r\nprobabilities, the existing Gazebo to the rear of the site at Cornermount Mount\r\nPark Road, Harrow On The Hill, Harrow, HA1 3LB, has been in situ for a\r\ncontinuous period of at least 4 years prior to the date of this application.\r\nThe existing structure is therefore considered to be lawful and as such the\r\nLocal Planning Authority issue a Certificate of Lawful Existing Development.&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;"
  ],
