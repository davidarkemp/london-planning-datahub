  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-family:Arial,Helvetica,sans-serif;&quot;&gt;&lt;span style=&quot;font-size:12pt;&quot;&gt;The proposal, by virtue of the proposed use as a habitable bedroom, would result in primary accommodation being located in an outbuilding, and would therefore not be for a purpose incidental to the main dwellinghouse, particularly for a C3(b) use where care services are&amp;nbsp;required.&amp;nbsp; Furthermore, the proposed bedroom would be out of keeping with the established residential character of the area and would set a precedence toward providing bedroom accommodation in outbuildings contrary to the high quality design aspirations of the National Planning Policy Framework (2024), D3 D(7) and D(11) of The&amp;nbsp; London Plan (2021), and Policy GR1 of the Harrow Local Plan (2021-2041) and the adopted Supplementary Planning Document: Residential Design Guide (2010).&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;"
