  "decision_conditions": [
    "&lt;p&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif;&quot;&gt;&lt;span style=&quot;font-size:12pt&quot;&gt;&lt;span style=&quot;height: 53.45pt; font-size: 14px;&quot;&gt;The proposal fails to fall within the parameters of permitted development as set out under&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Class A, paragraphs A.1(f)/A.1(g), A.1(h)(i), A.1(i), A.1(j), A.1(ja), A.1(k)(i), A.3(a),&amp;nbsp;A.3(b) and A.4,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif;&quot;&gt;&lt;span style=&quot;font-size:12pt&quot;&gt;&lt;span style=&quot;height: 53.45pt; font-size: 14px;&quot;&gt;Class B paragraphs B1(d) and B.2(a) and Class D, paragraphs D.1(b) and D.1(c)&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-family: Arial, Helvetica, sans-serif;&quot;&gt;&lt;span style=&quot;font-size:12pt&quot;&gt;&lt;span style=&quot;height: 53.45pt; font-size: 14px;&quot;&gt;from Schedule 2, Part 1, Classes A and B of the Town and Country Planning (General Permitted Development) (England) Order 2015 (as amended).&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;",
    "&lt;p&gt;The proposal is therefore not a lawful development.&lt;/p&gt;"
