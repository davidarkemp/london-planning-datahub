  "description": "Demolition of extension to the rear of the building, provision of new hall, kitchen/servery and plant room within single-storey extension along Hotham Road. (Amendments to planning permission 2009/2419, granted 17.09.09).",
  "last_date_consultation_comments": "15/04/2010",
  "application_details": {},
  "pp_id": null,
  "actual_commencement_date": null,
  "uprn": "100023311331",
