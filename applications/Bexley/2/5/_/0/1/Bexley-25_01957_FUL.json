    "open_and_protected_space_details": {
      "open_spaces_details": [
        {
          "area": 0.005,
          "access": "Restricted",
          "land_swap": false,
          "open_space_designation": "Not Designated",
          "description": "The proposed development at 121 Halcot Ave will result in a change of use of the existing open space, specifically the garden areas surrounding the current dwelling. These spaces—while privately held—function as informal open spaces with ecological and amenity value. Redevelopment will alter their use, potentially reducing permeable surface area and modifying habitat conditions.\nThe proposed development will result in a change of use of existing garden space—currently functioning as informal open space with ecological and amenity value. While privately held, these areas contribute to local green infrastructure and biodiversity.\nTo mitigate this change and comply with the Biodiversity Gain Condition, the following compensatory greening and biodiversity enhancements are proposed:\n• \tNative Hedgerow Planting: Along site boundaries to support birds, pollinators, and small mammals.\n• \tPollinator-Friendly Borders: Incorporating wildflowers and nectar-rich perennials.\n• \tTree Planting: At least one native tree (e.g., silver birch or rowan) to replace any removed vegetation.\n• \tHabitat Features: Bat and bird boxes, log piles, and insect hotels to support species diversity.\n• \tPermeable Surfaces: To maintain soil health and reduce runoff.\n• \t30-Year Management Plan: Ensuring long-term ecological benefit and habitat maturity.\nThese measures align with national biodiversity net gain guidance and reflect a commitment to ecological stewardship, even within a modest residential footprint.\n\nReflection: Stewardship of Space\nWe build not to erase, but to evolve. The open space that once breathed freely will now be shaped with intention—its memory carried in hedgerows, its spirit echoed in wildflowers. Each bat box, each native tree, each bloom is a gesture of gratitude.\nThis is not just development. It is a covenant with the land. A promise that what is taken will be returned—not in kind, but in care.\n",
          "open_space_type": "Natural and semi-natural"
        }
      ],
      "open_space_green_belt_area_gain": 0,
      "open_space_mol_area_loss": 0,
      "protected_space_count": 1,
      "open_space_local_and_other_area_loss": 0,
      "protected_spaces_details": [
        {
          "area": 0.005,
          "access": "Restricted",
          "description": "The proposed development at 121 Halcot Ave will result in a change of use of the existing garden space—currently functioning as informal open space with ecological and amenity value. While privately held, these areas contribute to local green infrastructure and biodiversity.\nTo mitigate this change and comply with the Biodiversity Gain Condition, the following compensatory greening and biodiversity enhancements are proposed:\n- Native Hedgerow Planting: Along site boundaries to support birds, pollinators, and small mammals.\n- Pollinator-Friendly Borders: Incorporating wildflowers and nectar-rich perennials.\n- Tree Planting: At least one native tree (e.g., silver birch or rowan) to replace any removed vegetation.\n- Habitat Features: Bat and bird boxes, log piles, and insect hotels to support species diversity.\n- Permeable Surfaces: To maintain soil health and reduce runoff.\n- 30-Year Management Plan: Ensuring long-term ecological benefit and habitat maturity.\nThese measures align with national biodiversity net gain guidance and reflect a commitment to ecological stewardship, even within a modest residential footprint.\n\nReflection: Stewardship of Space\nThis garden once held quiet rituals—\nthe hum of bees, the rustle of leaves, the soft imprint of bare feet on summer soil.\nNow, as foundations rise, we do not forget.\n\nWe build not to erase, but to evolve. The open space that once breathed freely will now be shaped with intention—its memory carried in hedgerows, its spirit echoed in wildflowers. Each bat box, each native tree, each bloom is a gesture of gratitude.\nThis is not just development. It is a covenant with the land. A promise that what is taken will be returned—not in kind, but in care.\n",
          "nature_conservation_designation": "Not Designated",
          "change_type": "Gain"
        }
